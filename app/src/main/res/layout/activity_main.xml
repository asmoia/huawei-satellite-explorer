<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060A14">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0C1222"
        app:title="Satellite Finder &amp; Pointer"
        app:titleTextColor="#FFFFFF"
        app:subtitle="Huawei Satellite Engine • Dish &amp; Sky Guide"
        app:subtitleTextColor="#00E5FF" />

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0C1222"
        app:tabIndicatorColor="#00E5FF"
        app:tabSelectedTextColor="#00E5FF"
        app:tabTextColor="#8A9BB0"
        app:tabMode="fixed" />

    <!-- FrameLayout for Tab Contents -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <!-- TAB 0: Cinematic Huawei Alignment Screen -->
        <ScrollView
            android:id="@+id/viewAlign"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Satellite Selector Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#0F172A"
                    app:strokeColor="#1E293B"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Target Satellite:"
                            android:textColor="#00E5FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spSatellites"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Calculated Look Angles Card (Azimuth, Elevation, LNB Skew) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLookAngles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#0F172A"
                    app:strokeColor="#1E293B"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Azimuth -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AZIMUTH"
                                    android:textColor="#64748B"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvAzimuthValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="162.4°"
                                    android:textColor="#00E5FF"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Elevation -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ELEVATION"
                                    android:textColor="#64748B"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvElevationValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="49.1°"
                                    android:textColor="#FFD700"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- LNB Skew -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="LNB SKEW"
                                    android:textColor="#64748B"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvSkewValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-11.2°"
                                    android:textColor="#00E676"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cinematic Alignment Radar Canvas -->
                <com.huawei.satellite.explorer.view.HuaweiCinematicAlignmentView
                    android:id="@+id/cinematicAlignmentView"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_gravity="center_horizontal" />

                <!-- Alignment Status Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlignmentStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#0F172A"
                    app:strokeColor="#1E293B"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvAlignmentInstruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Move phone to bring guidance ball into the center target circle."
                            android:textColor="#E2E8F0"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLiveAttitude"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone Heading: 0° | Pitch: 0° | Offset Error: ---"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 1: Live GNSS Sky Radar (Kirin Hardware Satellites) -->
        <ScrollView
            android:id="@+id/viewGnss"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live GNSS Constellation (Kirin 9000S1 Multi-Band)"
                    android:textColor="#00E5FF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="6dp" />

                <!-- Sky Dome Canvas -->
                <com.huawei.satellite.explorer.view.GnssSkyView
                    android:id="@+id/gnssSkyView"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />

                <!-- Constellation Legend Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#0F172A"
                    app:strokeColor="#1E293B"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvBdsStats"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="● BeiDou: 0"
                                android:textColor="#00E676"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvGpsStats"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="● GPS: 0"
                                android:textColor="#29B6F6"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">
                            <TextView
                                android:id="@+id/tvGlonassStats"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="● GLONASS: 0"
                                android:textColor="#FF7043"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvGalileoStats"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="● Galileo: 0"
                                android:textColor="#AB47BC"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvGnssSignalQuality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Peak Signal: 0.0 dB-Hz"
                            android:textColor="#FFD700"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: TV & Transponder Guide -->
        <ScrollView
            android:id="@+id/viewChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/containerSatCatalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- TAB 3: Diagnostics & RSMC Service -->
        <ScrollView
            android:id="@+id/viewTools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRunDiagnostic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Re-Scan System &amp; HAL"
                    android:layout_marginBottom="8dp" />

                <!-- Service actions -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#0F172A"
                    app:strokeColor="#1E293B"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Huawei SmcService IPC Bridge"
                            android:textStyle="bold"
                            android:textColor="#00E5FF"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBindService"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Connect to SmcService (com.huawei.lbs)"
                            android:layout_marginTop="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQueryCapabilities"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="#FFFFFF"
                            android:text="Query Modem Capabilities"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/containerDiagnosticResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Telemetry & Event Log -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="#04070E"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Live Sensor &amp; Orbital Console"
                android:textColor="#00E5FF"
                android:textStyle="bold"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/btnClearLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLEAR"
                android:textColor="#64B5F6"
                android:textSize="11sp"
                android:padding="4dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp">
            <TextView
                android:id="@+id/tvLogOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#80D8FF"
                android:textSize="11sp"
                android:text="Satellite Pointer Ready.\n" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
